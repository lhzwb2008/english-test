# 从 Coze 开放平台获取：https://www.coze.cn/open/oauth/pats
# 或你提供的 Service / PAT（勿提交真实值到 Git）
COZE_API_TOKEN=

# 国内站默认；国际站可改为 https://api.coze.com
COZE_BASE_URL=https://api.coze.cn

# 调试对话时使用的终端用户标识（可任意固定字符串）
COZE_DEBUG_USER_ID=local-dev-user

# 可选：创建智能体时指定空间（默认脚本内「共享空间」）
# COZE_SPACE_ID=

# 可选：创建时指定模型 ID（不设置则使用空间默认模型）
# COZE_MODEL_ID=

# --- Qwen-Omni 口语批改兼容代理（npm run qwen:serve）---
# 阿里云百炼 API Key：https://help.aliyun.com/zh/model-studio/get-api-key
# 仅服务端持有，不对外暴露；业务侧调用代理无需传任何 token（见 API.md）。
DASHSCOPE_API_KEY=
# 代理监听端口
QWEN_PROXY_PORT=8787
# 口语批改 / 万能音频模型（见 coze/qwen-bots.registry.json）
QWEN_ORAL_MODEL=qwen3.5-omni-flash
QWEN_UNIVERSAL_MODEL=qwen3.5-omni-flash
# 可选：DashScope OpenAI 兼容端点
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
