# 从 Coze 开放平台获取：https://www.coze.cn/open/oauth/pats
# 或你提供的 Service / PAT（勿提交真实值到 Git）
COZE_API_TOKEN=

# 国内站默认；国际站可改为 https://api.coze.com
COZE_BASE_URL=https://api.coze.cn

# 调试对话时使用的终端用户标识（可任意固定字符串）
COZE_DEBUG_USER_ID=local-dev-user

# 可选：创建智能体时指定空间（默认脚本内「共享空间」）
# COZE_SPACE_ID=

# 可选：创建时指定模型 ID（不设置则使用空间默认模型）
# COZE_MODEL_ID=

# --- Qwen-Omni 口语批改兼容代理（npm run qwen:serve）---
# 阿里云百炼 API Key：https://help.aliyun.com/zh/model-studio/get-api-key
# 仅服务端持有，不对外暴露；业务侧调用代理无需传任何 token（见 API.md）。
DASHSCOPE_API_KEY=
# 代理监听端口
QWEN_PROXY_PORT=8787
# 口语批改 / 万能音频模型（见 coze/qwen-bots.registry.json）
QWEN_ORAL_MODEL=qwen3.5-omni-flash
QWEN_UNIVERSAL_MODEL=qwen3.5-omni-flash
# 语法薄弱点总评 / 讲解出题（文本模型，默认 qwen3.8-max）
QWEN_TEXT_MODEL=qwen3.8-max
# 可选：DashScope OpenAI 兼容端点
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- 知识点口播短视频（/v1/grammar/video）---
# 对外拼绝对 video_url 用（仅 OSS 未配置时的本机回退）
# PUBLIC_BASE_URL=http://127.0.0.1:8787
# DASHSCOPE_TTS_MODEL=cosyvoice-v2
# DASHSCOPE_TTS_VOICE=longshu_v2
# DASHSCOPE_IMAGE_MODEL=wan2.2-t2i-flash
# DASHSCOPE_IMAGE_SIZE=768*1280
# GRAMMAR_VIDEO_MAX_SLIDES=5
# FFMPEG_PATH=ffmpeg
# GRAMMAR_VIDEO_FONT=/usr/share/fonts/truetype/wqy/wqy-microhei.ttc

# --- 阿里云 OSS（口播成片公网分发；密钥勿提交 Git）---
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET=nba-dev-sh
# OSS_PREFIX=wenbo
# OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
# OSS_REGION=oss-cn-shanghai
# Bucket 私有请用 signed（默认）；公有读且 CNAME 证书就绪再改 public
# OSS_URL_MODE=signed
# OSS_SIGNED_URL_SECONDS=604800
# OSS_PUBLIC_BASE_URL=https://nba-dev-sh.cn-shanghai.taihangpfm.cn

# --- 生产部署信息（方便查阅，脚本可不读）---
# DEPLOY_HOST=101.201.237.149
# DEPLOY_USER=root
# DEPLOY_PATH=/opt/qwen-oral-proxy
# DEPLOY_PORT=8000
# PM2_APP_NAME=qwen-oral-proxy
