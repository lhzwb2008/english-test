{
  "name": "english-coze-mvp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "英语学习 Coze 智能体：Prompt 维护与推送脚本",
  "scripts": {
    "coze:export-builtin": "python3 scripts/export-builtin-from-excels.py",
    "coze:build-plan": "node scripts/build-learning-plan.mjs",
    "coze:create": "node scripts/create-english-bots.mjs",
    "coze:spaces": "node scripts/list-workspaces.mjs",
    "coze:push-plan": "npm run coze:build-plan --silent && node scripts/push-learning-plan-prompt.mjs",
    "coze:push-oral": "node scripts/push-oral-prompt.mjs",
    "coze:push-image": "node scripts/push-image-prompt.mjs",
    "coze:push-knowledge": "node scripts/push-knowledge-prompt.mjs",
    "coze:create-knowledge": "node scripts/create-knowledge-bot.mjs",
    "coze:debug-plan": "node scripts/debug-learning-plan.mjs",
    "coze:debug-plan-repro": "node scripts/debug-learning-plan-repro.mjs",
    "coze:debug-oral": "node scripts/debug-oral-audio.mjs",
    "qwen:serve": "node server/index.mjs",
    "qwen:debug-oral": "node scripts/debug-qwen-oral-proxy.mjs"
  },
  "dependencies": {
    "@coze/api": "^1.3.9",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.2",
    "openai": "^4.104.0"
  }
}
